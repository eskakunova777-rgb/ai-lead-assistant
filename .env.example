# Скопируйте в .env и заполните сами. Файл .env никому не присылайте и не показывайте на скриншотах.
# Ключ создаётся на https://openrouter.ai/keys
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Можно несколько моделей через запятую: если первая перегружена, берётся следующая.
LLM_MODEL=google/gemma-4-31b-it:free,poolside/laguna-s-2.1:free,nvidia/nemotron-3-ultra-550b-a55b:free
PORT=3100

# Битрикс24: входящий вебхук с правами crm, task, im. Адрес вида https://ВАШ-ПОРТАЛ.bitrix24.ru/rest/1/КЛЮЧ/
B24_URL=
# Кому приходит уведомление (ID пользователя в Битрикс24, у владельца портала обычно 1)
B24_NOTIFY_USER_ID=1
